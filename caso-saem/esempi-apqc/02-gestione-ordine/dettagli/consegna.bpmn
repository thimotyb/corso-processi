  <bpmn:process id="Consegna" name="Consegna pianificata · Evasione e fatturazione" isExecutable="false">
    <bpmn:documentation>TO-BE · logistica mantenuta; orchestrazione per consegna didattica. PDF 37, 95, 113–117 / stampate 25, 83, 101–105. Modello didattico completo nel perimetro ordine→spedizione→fatturazione; vedere processo.md per fonti e assunzioni.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_Consegna">
      <bpmn:lane id="Lane_Consegna_1" name="RGC / contabilità · Ciclo fatturazione">
        <bpmn:flowNodeRef>Sub_Fattura</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_Settimana</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Consegna_0" name="RGC / magazzino · Calendario consegna">
        <bpmn:flowNodeRef>C_Ripiano</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_Logistica</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_Data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_Spedita</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
