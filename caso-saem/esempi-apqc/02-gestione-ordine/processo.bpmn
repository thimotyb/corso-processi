  <bpmn:collaboration id="Collaboration_SAEM">
    <bpmn:participant id="Participant_SAEM" name="SAEM · ordine cliente · TO-BE MaxNet" processRef="Process_SAEM_Ordine" />
    <bpmn:participant id="Participant_Cliente" name="Cliente (partecipante esterno)" />
    <bpmn:messageFlow id="Message_Richiesta" name="Richiesta" sourceRef="Participant_Cliente" targetRef="Start_Main" />
    <bpmn:messageFlow id="Message_Offerta" name="Offerta" sourceRef="Sub_Offerta" targetRef="Participant_Cliente" />
    <bpmn:messageFlow id="Message_Ordine" name="Dati ordine" sourceRef="Participant_Cliente" targetRef="Sub_Ordine" />
    <bpmn:messageFlow id="Message_Variazione" name="Variazione" sourceRef="Participant_Cliente" targetRef="Sub_Modifica" />
    <bpmn:messageFlow id="Message_Conferma" name="Conferma" sourceRef="M_Conferma" targetRef="Participant_Cliente" />
  </bpmn:collaboration>
  <bpmn:process id="Process_SAEM_Ordine" name="SAEM · Gestione ordine cliente · TO-BE" isExecutable="false">
    <bpmn:documentation>TO-BE MaxNet III. PDF 95 / stampata 83; dettagli D.1, D.2, D.7, D.9, D.10, D.11. Modello didattico completo nel perimetro ordine→spedizione→fatturazione; vedere processo.md per fonti e assunzioni.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_Process_SAEM_Ordine">
      <bpmn:lane id="Lane_Process_SAEM_Ordine_3" name="Magazzino / contabilità · Consegne">
        <bpmn:flowNodeRef>End_Main</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_Consegna</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_SAEM_Ordine_2" name="RGC · Rilascio e gestione variazioni">
        <bpmn:flowNodeRef>M_Controllo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Rilascio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Blocco</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Rinuncia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Blocco</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Variazioni</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Conferma</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_SAEM_Ordine_1" name="MaxNet III · Acquisizione ordine">
        <bpmn:flowNodeRef>G_OrdineEsito</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NoOrdine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Annullato</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Annullato</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_Ordine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_Modifica</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_SAEM_Ordine_0" name="RGC / FC · Gestione commerciale">
        <bpmn:flowNodeRef>Start_Main</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Offerta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_OffertaEsito</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Offerta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_Offerta</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Main" name="Richiesta cliente">
      <bpmn:documentation>Scenario: TO-BE MaxNet III. Responsabilità: RGC / FC · Gestione commerciale.
Fonte: PDF 95 / stampata 83; dettagli D.1, D.2, D.7, D.9, D.10, D.11.
Evidenza: Attività / relazione derivata dalla fonte; aggregazione e traduzione BPMN didattiche.
Entità/tabelle non specificate per questa decisione/evento.</bpmn:documentation>
      <bpmn:outgoing>Flow_Process_SAEM_Ordine_0</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Message_Start_Main" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="G_Offerta" name="Serve un&#39;offerta?" default="Flow_Process_SAEM_Ordine_2">
