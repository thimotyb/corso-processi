# Versioni immagini — allineate alla distribuzione ufficiale Camunda 8.9
# (repo camunda/camunda-distributions, release docker-compose-8.9).
CAMUNDA_VERSION=8.9.17
CAMUNDA_CONNECTORS_VERSION=8.9.9

# Hostname usato negli URL mostrati dalle UI (accesso da browser).
HOST=localhost

# Autorizzazioni per risorsa in Operate/Tasklist.
RESOURCE_AUTHORIZATIONS_ENABLED=true
